        <mxCell id="7" value="&lt;b&gt;ENRUTADOR&lt;br/&gt;CENTRAL&lt;/b&gt;&lt;br/&gt;&lt;small&gt;Clasificación&lt;br/&gt;por atributos&lt;/small&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#805AD5;strokeWidth=2;fontColor=#44337A;fontStyle=1;fontSize=12;shadow=1;" vertex="1" parent="1">
