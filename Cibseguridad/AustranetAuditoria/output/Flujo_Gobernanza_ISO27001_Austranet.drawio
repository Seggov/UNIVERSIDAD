        </mxCell>
        <mxCell id="8" value="&lt;b&gt;🛡️ PROTOCOLO 5: MFA Roles Críticos&lt;/b&gt;&lt;br/&gt;• Censo de 15 roles administrativos&lt;br/&gt;• Verificación política en modo Enforce&lt;br/&gt;• &lt;b&gt;Exclusión explícita de Break-Glass&lt;/b&gt;&lt;br/&gt;&lt;small style='color:#4A5568;'&gt;ISO 27001: A.5.17 / A.8.2&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;strokeWidth=2;fontColor=#1A365D;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="90" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;⚡ PROTOCOLO 1: Cuentas Nuevas (5d)&lt;/b&gt;&lt;br/&gt;• Exclusión de cuentas de servicio (6)&lt;br/&gt;• Alerta a jefatura al día 3 hábil&lt;br/&gt;• &lt;b&gt;Bloqueo al día 5 sin inicio de sesión&lt;/b&gt;&lt;br/&gt;&lt;small style='color:#4A5568;'&gt;Población: 11 sin login | ISO A.5.16&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;strokeWidth=2;fontColor=#744210;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="240" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;⏳ PROTOCOLO 2: Inactividad &amp;gt; 60 Días&lt;/b&gt;&lt;br/&gt;• Cuarentena lógica a los 30 días&lt;br/&gt;• Notificación preventiva día 50&lt;br/&gt;• &lt;b&gt;Bloqueo formal + Revocar sesiones día 60&lt;/b&gt;&lt;br/&gt;&lt;small style='color:#4A5568;'&gt;Población: 53 inactivas | ISO A.5.15&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7D7;strokeColor=#E53E3E;strokeWidth=2;fontColor=#742A2A;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;🌐 PROTOCOLO 4: Ciclo de Vida Guests&lt;/b&gt;&lt;br/&gt;• 117 sin canje: revocar invitaciones &amp;gt; 30d&lt;br/&gt;• 101 inactivos &amp;gt; 60d: baja directa sin buzón&lt;br/&gt;• 79 activos: recertificación periódica&lt;br/&gt;&lt;small style='color:#4A5568;'&gt;Población: 306 invitados | ISO A.5.19&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#718096;strokeWidth=2;fontColor=#2D3748;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="560" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;📦 PROTOCOLO 3: Offboarding &amp;amp; Retención&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Paso 1:&lt;/b&gt; Convertir buzón a Shared Mailbox&lt;br/&gt;• &lt;b&gt;Paso 2:&lt;/b&gt; Respaldar / delegar OneDrive&lt;br/&gt;• &lt;b&gt;Paso 3:&lt;/b&gt; Desasignar licencias de pago M365&lt;br/&gt;• &lt;b&gt;Paso 4:&lt;/b&gt; Espera de retención legal (60 días)&lt;br/&gt;• &lt;b&gt;Paso 5:&lt;/b&gt; Evaluar borrado final en Entra ID&lt;br/&gt;&lt;small style='color:#4A5568;'&gt;Población: 46 bloqueadas | ISO A.8.10&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;strokeWidth=2;fontColor=#44337A;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="310" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;📧 1. NOTIFICACIONES &amp;amp; ALERTAS&lt;/b&gt;&lt;br/&gt;• Correo preventivo a jefaturas (días 3 y 50)&lt;br/&gt;• Alerta de seguridad por uso de Break-Glass&lt;br/&gt;• Aviso formal de cuenta bloqueada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;strokeWidth=2;fontColor=#744210;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="120" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;☁️ 2. ACCIONES CLOUD (Graph / M365)&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;accountEnabled: false&lt;/code&gt; ejecutado&lt;br/&gt;• Tokens de sesión revocados en Graph&lt;br/&gt;• Buzón compartido activo sin costo de licencia&lt;br/&gt;• Eliminación definitiva de cuentas purgadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=2;fontColor=#1A365D;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
