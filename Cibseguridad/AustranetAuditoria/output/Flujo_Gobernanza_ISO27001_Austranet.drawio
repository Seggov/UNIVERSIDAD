        <mxCell id="6" value="&lt;b&gt;📥 DATASET MAESTRO (CSV)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;exportUsers_2026-10-28.csv&lt;/code&gt;&lt;br/&gt;&lt;hr style='margin:4px 0;'/&gt;• 495 Cuentas Microsoft Entra ID&lt;br/&gt;• UserType: 189 Member / 306 Guest&lt;br/&gt;• Actividad de login y roles admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;strokeWidth=2;fontColor=#1A365D;fontSize=12;shadow=1;" vertex="1" parent="1">
