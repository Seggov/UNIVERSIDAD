        </mxCell>
        <mxCell id="15" value="&lt;b&gt;📁 3. EVIDENCIAS ISO 27001 (GRC)&lt;/b&gt;&lt;br/&gt;• Matriz actualizada de identidades (9.1)&lt;br/&gt;• Trazabilidad de excepciones y justificaciones&lt;br/&gt;• Expedientes listos para Auditoría Interna (9.2)&lt;br/&gt;• Registro histórico en SharePoint / AustranetGRC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;strokeWidth=2;fontColor=#22543D;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
