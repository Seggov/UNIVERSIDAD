    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;1. Análisis Exploratorio de Datos — EDA (Objetivo 1)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Evolución diaria 2018–2020, distribución por día de la semana (ordenado Lunes–Domingo), promedio mensual, mediana por día del mes e histograma de demanda.&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="15793151"/>
            <entry key="x-coordinate" type="xint" value="230"/>
            <entry key="y-coordinate" type="xint" value="-285"/>
            <entry key="width" type="xint" value="540"/>
            <entry key="height" type="xint" value="525"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="4"/>
            <entry key="borderColor" type="xint" value="3978097"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_1">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;2. Carga, Preparación y Definición de Alta Demanda (Objetivo 2)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Ruta relativa (knime.workflow.data/demanda_diaria.csv). Crea mes_nombre y periodo_mes, define alta_demanda con P75 de Train (51.849,75 verificado por GroupBy), genera variables dummy una vez y realiza split temporal (Train 366d &lt; 2019-09-21 / Test 368d).&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16775645"/>
            <entry key="x-coordinate" type="xint" value="-55"/>
            <entry key="y-coordinate" type="xint" value="255"/>
            <entry key="width" type="xint" value="1140"/>
            <entry key="height" type="xint" value="380"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="4"/>
            <entry key="borderColor" type="xint" value="16750848"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
        <config key="annotation_2">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;3. Modelado Progresivo con Regresión Logística y Evaluación (Objetivo 3)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;4 modelos temporales con Prior Gaussiano (var=10, eps=1e-5; resuelve separación en marzo), referencias omitidas (enero, Lunes, inicio_mes), umbral 0.30 en Modelo 2, probabilidades activadas, Scorer y Curva ROC (AUC).&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="15269866"/>
            <entry key="x-coordinate" type="xint" value="1125"/>
            <entry key="y-coordinate" type="xint" value="120"/>
            <entry key="width" type="xint" value="725"/>
            <entry key="height" type="xint" value="825"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="4"/>
            <entry key="borderColor" type="xint" value="3381555"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
    </config>
